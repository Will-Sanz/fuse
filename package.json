{
  "name": "fuse",
  "version": "0.3.0",
  "private": true,
  "description": "Local MCP server and custom visual explanations for TypeScript changes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Will-Sanz/fuse.git"
  },
  "files": [
    "cli",
    "server",
    "shared",
    "dist",
    "tsconfig.json",
    "scripts/meeting.mjs",
    "docs/meeting.md",
    "docs/integration.md",
    "src/untitledui/LICENSE",
    "src/untitledui/PROVENANCE.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "prepare": "npm run build",
    "build:showcase": "node scripts/build-showcase.mjs && tsc --noEmit && vite build --mode showcase",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:showcase": "playwright test --config playwright.showcase.config.ts",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fuse": "node cli/run.mjs",
    "demo:verify": "node scripts/acceptance.mjs",
    "meeting": "node scripts/meeting.mjs",
    "meeting:verify": "node scripts/meeting.mjs --verify --no-open",
    "package:check": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "@untitledui/icons": "^0.0.23",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.4",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "bin": {
    "fuse": "cli/run.mjs"
  }
}
