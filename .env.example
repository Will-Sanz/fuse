# Optional: legacy GitHub-import API access to private repositories. Server only.
GITHUB_TOKEN=
# Optional: defaults to 3001. The dev proxy expects 3001.
PORT=3001
# Optional: local fixture repositories and legacy snapshots, ignored by Git.
FUSE_DEMO_DIR=data/demos
# Maintainer-only direct development key. Teammates do not need this.
OPENAI_API_KEY=
FUSE_AI_MODEL=gpt-6-luna

# Team MCP access to the hosted service. This is not an OpenAI key. Keep private.
FUSE_SERVICE_TOKEN=
# Optional: use a different hosted Fuse service (HTTPS; localhost HTTP allowed for testing).
# FUSE_AI_URL=https://fuse-alpha-seven.vercel.app/api/visual
